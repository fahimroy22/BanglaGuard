# ============================================================
# BanglaGuard Production Environment
# Copy this file to .env.production and replace every secret.
# Never commit .env.production.
# ============================================================

APP_NAME=BanglaGuard API
APP_VERSION=1.0.0
APP_ENV=production
DEBUG=false

# API
API_V1_PREFIX=/api/v1
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
WEB_CONCURRENCY=2

# Security
SECRET_KEY=REPLACE_SECRET_KEY
JWT_SECRET_KEY=REPLACE_JWT_SECRET_KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Change this to your real frontend domain in production
CORS_ORIGINS=["http://localhost:3000"]

# PostgreSQL
POSTGRES_USER=banglaguard
POSTGRES_PASSWORD=REPLACE_POSTGRES_PASSWORD
POSTGRES_DB=banglaguard
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

DATABASE_URL=postgresql+asyncpg://banglaguard:REPLACE_POSTGRES_PASSWORD@postgres:5432/banglaguard

# Alembic may require a synchronous URL
SYNC_DATABASE_URL=postgresql+psycopg://banglaguard:REPLACE_WITH_A_STRONG_DATABASE_PASSWORD@postgres:5432/banglaguard

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=REPLACE_REDIS_PASSWORD
REDIS_URL=redis://:REPLACE_REDIS_PASSWORD@redis:6379/0

# Prediction privacy
STORE_PREDICTION_TEXT=true

# Upload limits
MAX_UPLOAD_SIZE_MB=50
MAX_BATCH_ITEMS=500

# Logging
LOG_LEVEL=INFO

# Hugging Face
HF_TOKEN=

# Initial administrator
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=REPLACE_INITIAL_ADMIN_PASSWORD
INITIAL_ADMIN_FULL_NAME=BanglaGuard Administrator