# General
APP_ENV=development
APP_NAME=BanglaGuard
DEBUG=true

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=replace-this-with-a-secure-random-value

# PostgreSQL
POSTGRES_USER=banglaguard
POSTGRES_PASSWORD=banglaguard_dev_password
POSTGRES_DB=banglaguard
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://banglaguard:banglaguard_dev_password@postgres:5432/banglaguard

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Storage
MODEL_STORAGE_PATH=/app/storage/models
UPLOAD_STORAGE_PATH=/app/storage/uploads
REPORT_STORAGE_PATH=/app/storage/reports