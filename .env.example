# Application
APP_NAME=BanglaGuard API
APP_VERSION=0.2.0
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Security
SECRET_KEY=replace-with-a-long-random-secret

# Frontend
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# PostgreSQL
POSTGRES_USER=banglaguard
POSTGRES_PASSWORD=banglaguard_dev_password
POSTGRES_DB=banglaguard
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DATABASE_URL=postgresql+asyncpg://banglaguard:banglaguard_dev_password@localhost:5432/banglaguard

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# Storage
MODEL_STORAGE_PATH=storage/models
UPLOAD_STORAGE_PATH=storage/uploads
REPORT_STORAGE_PATH=storage/reports

# Authentication
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Prediction privacy
STORE_PREDICTION_TEXT=true
